# Copy to .env (never commit .env).
# 32 random bytes, base64: openssl rand -base64 32
CUSTOMSVN_MASTER_KEY=
POSTGRES_PASSWORD=customsvn
# The first admin, created when the database has no user. Leave the password
# empty to have one generated and printed once in the server log.
CUSTOMSVN_ADMIN_EMAIL=admin
CUSTOMSVN_ADMIN_PASSWORD=
# Bearer token for /v1 and /mcp from other programs (empty: logged-in sessions only).
CUSTOMSVN_API_TOKEN=
# 1 behind a TLS proxy that does not send X-Forwarded-Proto.
CUSTOMSVN_SECURE_COOKIE=
CUSTOMSVN_PORT=8080
# Optional: keys read by providers that name these variables.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
